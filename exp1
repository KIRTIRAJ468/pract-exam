<!DOCTYPE html>
<html>
<head>
    <title>JavaScript Quiz</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            padding: 40px;
        }

        .container {
            max-width: 500px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 2px 10px #ccc;
        }

        h2 {
            text-align: center;
        }

        .question {
            margin: 20px 0;
            font-size: 18px;
        }

        .option {
            display: block;
            padding: 12px;
            border: 1px solid #ddd;
            margin: 10px 0;
            border-radius: 5px;
            cursor: pointer;
        }

        .option:hover {
            background: #f0f0f0;
        }

        button {
            background: #555;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:disabled {
            background: #aaa;
            cursor: not-allowed;
        }

        .result {
            text-align: center;
        }

        .score {
            font-size: 35px;
            margin: 25px;
        }
    </style>
</head>

<body>

<div class="container" id="quizContainer">

    <h2>JavaScript Quiz</h2>

    <div id="quiz"></div>

</div>

<script>

    const questions = [

        {
            question: "Which keyword declares a constant variable?",
            options: ["var", "let", "const", "static"],
            answer: 2
        },

        {
            question: "Which method adds an element at the end of an array?",
            options: ["pop()", "push()", "shift()", "unshift()"],
            answer: 1
        },

        {
            question: "Which symbol is used for strict equality?",
            options: ["=", "==", "===", "!="],
            answer: 2
        },

        {
            question: "Which function converts JSON text into a JavaScript object?",
            options: [
                "JSON.stringify()",
                "JSON.parse()",
                "JSON.convert()",
                "JSON.object()"
            ],
            answer: 1
        }

    ];

    let currentQuestion = 0;
    let score = 0;
    let selectedAnswer = null;

    function showQuestion() {

        selectedAnswer = null;

        const q = questions[currentQuestion];

        let html = `
            <p>Question ${currentQuestion + 1} of ${questions.length}</p>

            <div class="question">
                ${q.question}
            </div>
        `;

        q.options.forEach((option, index) => {

            html += `
                <label class="option">
                    <input
                        type="radio"
                        name="answer"
                        value="${index}"
                        onchange="selectAnswer(${index})"
                    >
                    ${option}
                </label>
            `;

        });

        html += `
            <button id="nextBtn" onclick="nextQuestion()" disabled>
                ${currentQuestion === questions.length - 1
                    ? "Submit" : "Next"}
            </button>
        `;

        document.getElementById("quiz").innerHTML = html;
    }

    function selectAnswer(index) {

        selectedAnswer = index;

        document.getElementById("nextBtn").disabled = false;
    }

    function nextQuestion() {

        if (selectedAnswer === null) {
            return;
        }

        if (selectedAnswer === questions[currentQuestion].answer) {
            score++;
        }

        currentQuestion++;

        if (currentQuestion < questions.length) {

            showQuestion();

        } else {

            showResult();

        }
    }

    function showResult() {

        let percentage = (score / questions.length) * 100;

        let message = percentage === 100
            ? "Excellent job!"
            : "Keep practising!";

        document.getElementById("quiz").innerHTML = `

            <div class="result">

                <div class="score">
                    ${score} / ${questions.length}
                </div>

                <h3>You scored ${percentage}%</h3>

                <p>${message}</p>

                <button onclick="restartQuiz()">
                    Restart Quiz
                </button>

            </div>
        `;
    }

    function restartQuiz() {

        currentQuestion = 0;
        score = 0;
        selectedAnswer = null;

        showQuestion();
    }

    showQuestion();

</script>

</body>
</html>
